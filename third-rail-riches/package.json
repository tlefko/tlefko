{
  "name": "powder-keg-cove",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Powder Keg Cove: a 6x5 cascading cluster slot with exploding powder-keg wilds and the Captain's Wheel, played with simulated demo credits only.",
  "scripts": {
    "dev": "vite --port 5318 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5319 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/sim/cli.ts",
    "qa:soak": "node tools/qa/soak.mjs",
    "qa:layout": "node tools/qa/layout.mjs",
    "qa:perf": "node tools/qa/perf.mjs",
    "deploy": "bash deploy/deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/new-rocker": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.21.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
